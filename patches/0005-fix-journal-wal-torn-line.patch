+def test_wal_append_fsync_is_configurable(tmp_path, monkeypatch):
+    """fsync runs after each append by default and can be switched off."""
+    import os as _os
+
+    calls: list[int] = []
+    real_fsync = _os.fsync
+    monkeypatch.setattr(_os, "fsync", lambda fd: (calls.append(fd), real_fsync(fd))[1])
+
+    async def _append(fsync):
+        j = Journal(wal_path=str(tmp_path / f"{fsync}.wal"), fsync=fsync)
+        rec = _rec([["call", 0]])
+        await j.use(rec["key"], rec)
+
+    asyncio.run(_append(True))
+    assert len(calls) == 1
+    asyncio.run(_append(False))
+    assert len(calls) == 1
