+def test_load_tolerates_wal_torn_inside_multibyte_char(tmp_path):
+    """A WAL torn mid UTF-8 character loses only that line, not the whole file."""
+    wal = tmp_path / "run.wal"
+    good = json.dumps({"key": key_str([["call", 0]]), "sig": "s", "result": "中文结论"}, ensure_ascii=False)
+    torn = json.dumps({"key": key_str([["call", 1]]), "sig": "s", "result": "中文结论"}, ensure_ascii=False)
+    torn_bytes = torn.encode("utf-8")
+    cut = torn_bytes.index("结".encode("utf-8")) + 1  # keep only the lead byte of a 3-byte char
+    wal.write_bytes(good.encode("utf-8") + b"\n" + torn_bytes[:cut])
+
+    j = asyncio.run(Journal.load(None, wal_path=str(wal)))
+    assert set(j.prior) == {key_str([["call", 0]])}
+    assert j.load_stats == {"bad_utf8": 1}
+
+
+def test_append_after_torn_tail_starts_a_new_line(tmp_path):
+    """A fresh record appended after a torn last line survives the next load."""
+    wal = tmp_path / "run.wal"
+    good = json.dumps({"key": key_str([["call", 0]]), "sig": "s", "result": {"v": "ok"}})
+    wal.write_text(good + "\n" + '{"key": "[[\\"call\\", 1]]", "sig": "s", "resu', encoding="utf-8")
+
+    async def _resume_and_append():
+        j = await Journal.load(None, wal_path=str(wal))
+        assert j.load_stats == {"bad_json": 1}
+        rec = _rec([["call", 1]])
+        await j.use(rec["key"], rec)
+        assert j.load_stats.get("repaired_tail") == 1
+        return await Journal.load(None, wal_path=str(wal))
+
+    j2 = asyncio.run(_resume_and_append())
+    assert set(j2.prior) == {key_str([["call", 0]]), key_str([["call", 1]])}
+    assert wal.read_bytes().endswith(b"\n")
+
