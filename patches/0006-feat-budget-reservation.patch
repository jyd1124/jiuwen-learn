+
+# ---------------------------------------------------------------- reservations
+
+_FANOUT_SCRIPT = '''
+from swarmflow import agent, parallel
+
+META = {"name": "fanout", "description": "16 concurrent calls on one ceiling", "phases": []}
+
+async def run(args):
+    return await parallel([lambda i=i: agent(f"task {i}", label=f"b{i}") for i in range(16)])
+'''
+
+
+class _SlowFixedCostBackend(_FixedCostBackend):
+    """Fixed cost billed only after a delay, so concurrent calls overlap in flight."""
+
+    def __init__(self, cost: int) -> None:
+        super().__init__(cost)
+        self.in_flight = 0
+        self.max_in_flight = 0
+
+    async def run(
+        self, prompt: str, opts: dict, schema_json: dict | None, *, call_key: str | None = None
+    ) -> AgentResult:
+        self.in_flight += 1
+        self.max_in_flight = max(self.max_in_flight, self.in_flight)
+        try:
+            await asyncio.sleep(0.01)
+            return await super().run(prompt, opts, schema_json, call_key=call_key)
+        finally:
+            self.in_flight -= 1
+
+
+def test_reserve_admits_while_holds_fit_and_legacy_rule_when_idle():
+    """reserve() counts in-flight holds; with none held it keeps the old spent<total rule."""
+    ledger = BudgetLedger(total=100)
+    assert ledger.reserve(60) and ledger.reserved == 60
+    assert not ledger.reserve(60)  # 60 held + 60 > 100
+    assert ledger.reserve(40) and ledger.available() == 0
+    ledger.commit(60, 70, bill=True)
+    assert (ledger.spent, ledger.reserved) == (70, 40)
+    ledger.release(40)
+    assert ledger.reserved == 0
+    assert ledger.reserve(500)  # idle and spent < total: legacy admission
+    ledger.release(500)
+    ledger.add(30)
+    assert not ledger.reserve(1)  # spent >= total
+    assert BudgetLedger().reserve(10**9)  # unbounded always admits
+
+
+def test_estimate_learns_from_committed_calls():
+    """Before any commit: prompt + default completion reserve; after: mean real cost."""
+    ledger = BudgetLedger(total=10_000, default_completion_reserve=100)
+    assert ledger.estimate(20) == 120
+    ledger.commit(0, 300, bill=False)
+    ledger.commit(0, 500, bill=False)
+    assert ledger.spent == 0  # bill=False leaves billing to the backend
+    assert ledger.estimate(20) == 400
+
+
+def test_add_is_unchanged_by_reservations():
+    """add() still bills directly and ignores holds (backward compatible)."""
+    ledger = BudgetLedger(total=100)
+    ledger.reserve(50)
+    ledger.add(30)
+    assert (ledger.spent, ledger.reserved, ledger.remaining()) == (30, 50, 70)
+
+
+def test_parallel_fanout_overrun_is_bounded_by_reservations(tmp_path):
+    """16 concurrent 1500-token calls on a 10k ceiling no longer all start.
+
+    Without holds every branch passes the entry gate on spent=0 (24 000 billed).
+    With them, the in-flight holds cap admission; the residual overshoot is the
+    estimate error plus at most the one call admitted on an idle ledger.
+    """
+    # Accurate estimate (prompt + 1500 reserve ~ real cost): overshoot <= one call.
+    backend = _SlowFixedCostBackend(cost=1500)
+    ledger = BudgetLedger(total=10_000, default_completion_reserve=1500)
+    with pytest.raises(BudgetExhausted):
+        asyncio.run(run_workflow(_write(tmp_path, _FANOUT_SCRIPT), backend=backend, budget=ledger, cap=16))
+    assert ledger.spent <= 10_000 + 1500
+    assert backend.max_in_flight < 16
+    assert ledger.reserved == 0  # every hold was settled
+
+    # Under-estimate (default 1024 reserve): the overshoot grows by the estimate
+    # error of the first wave only, still far below the unreserved 16 x 1500.
+    backend = _SlowFixedCostBackend(cost=1500)
+    ledger = BudgetLedger(total=10_000)
+    with pytest.raises(BudgetExhausted):
+        asyncio.run(run_workflow(_write(tmp_path, _FANOUT_SCRIPT), backend=backend, budget=ledger, cap=16))
+    # ~1025-token holds admit at most 9 calls (9 x 1025 <= 10 000) in the first wave.
+    assert ledger.spent <= 10 * 1500
+    assert ledger.reserved == 0
