+        ``bill=True`` the cost is also added to ``spent`` (like :meth:`add`);
+        pass ``bill=False`` when the backend already reported it (the engine's
+        case — backends are the ledger's writers, see ``bind_budget``).
+        """
+        if actual is not None and actual > 0:
+            self._observed_calls += 1
+            self._observed_tokens += actual
+            if bill:
+                self.add(actual)
+        self.release(reserved)
