+#: Upper bound on one wait for an in-flight hold to settle before the
+#: reservation loop re-checks the ledgers (guards against a missed wake-up).
+_RESERVE_POLL_S = 1.0
+
+
+def _reservation_ledgers(rt) -> list:
+    """The run's ledgers that support reservations (per-run, session), de-duplicated."""
+    out: list = []
+    for ledger in (rt.workflow_budget, rt.budget):
+        if hasattr(ledger, "reserve") and all(ledger is not o for o in out):
+            out.append(ledger)
+    return out
+
+
+async def _reserve_call_budget(rt, prompt: str) -> int:
+    """Hold an estimated cost on every ledger before a call reaches the backend.
+
+    The entry gate (``_check_budget``) only sees tokens already reported, so N
+    concurrent calls all pass it before the first one returns. Here each call
+    must also fit next to the holds of the calls still in flight; one that does
+    not waits for an in-flight call to settle and re-checks — it then either
+    fits, or the ledger is genuinely spent and ``_check_budget`` raises
+    ``BudgetExhausted``. With nothing in flight the legacy rule applies
+    (admitted while ``spent < total``), so sequential runs are unchanged.
+
+    Returns the per-ledger hold, to be passed to :func:`_settle_call_budget`.
+    """
+    ledgers = _reservation_ledgers(rt)
+    if not ledgers:
+        return 0
+    while True:
+        _check_abort(rt)
+        _check_budget(rt)
+        # The most conservative ledger's estimate (each learns from the calls
+        # committed into it; the session ledger also remembers earlier runs).
+        est = max(ledger.estimate(len(prompt) // 4) for ledger in ledgers)
+        held: list = []
+        blocker = None
+        for ledger in ledgers:
+            if ledger.reserve(est):
+                held.append(ledger)
+            else:
+                blocker = ledger
+                break
+        if blocker is None:
+            return est
+        for ledger in held:
+            ledger.release(est)
+        try:
+            await asyncio.wait_for(blocker.wait_release(), _RESERVE_POLL_S)
+        except TimeoutError:
+            pass
+
+
+def _settle_call_budget(rt, reserved: int, actual: int | None) -> None:
+    """Release a call's holds, feeding its real cost to the estimator.
+
+    Never bills: the backend already reported the real usage into the ledgers
+    (``AgentBackend.bind_budget``), so ``commit`` runs with ``bill=False``.
+    """
+    for ledger in _reservation_ledgers(rt):
+        ledger.commit(reserved, actual, bill=False)
+
