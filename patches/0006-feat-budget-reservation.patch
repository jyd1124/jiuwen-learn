+    # --- reservations (admission control for concurrent calls) ---
+
+    def available(self) -> int | None:
+        """Tokens neither spent nor reserved, or ``None`` when unbounded."""
+        if self.total is None:
+            return None
+        return max(0, self.total - self.spent - self.reserved)
+
+    def estimate(self, prompt_tokens: int = 0) -> int:
+        """Reservation estimate for one call.
+
+        The mean real cost of this ledger's committed calls once any exist
+        (never below the prompt's own size), else the prompt plus
+        ``default_completion_reserve``.
+        """
+        prompt_tokens = max(0, int(prompt_tokens))
+        if self._observed_calls:
+            mean = -(-self._observed_tokens // self._observed_calls)  # ceil
+            return max(prompt_tokens, mean, 1)
+        return max(1, prompt_tokens + self.default_completion_reserve)
+
+    def reserve(self, tokens: int) -> bool:
+        """Hold ``tokens`` for a call about to start; ``False`` = do not start it.
+
+        Admitted when nothing is reserved and ``spent < total`` (the legacy
+        entry-gate rule, so a sequential run behaves exactly as before), or when
+        ``spent + reserved + tokens <= total``. Unbounded ledgers always admit
+        (the hold is still tracked). Every ``True`` must be paired with exactly
+        one :meth:`commit` or :meth:`release` of the same amount.
+        """
+        tokens = max(0, int(tokens))
+        if self.total is not None:
+            committed = self.spent + self.reserved
+            if committed >= self.total:
+                return False
+            if self.reserved > 0 and committed + tokens > self.total:
+                return False
+        self.reserved += tokens
+        return True
+
+    def release(self, reserved: int) -> None:
