+    def _approval_to_interactive_input(data: dict) -> Any:
+        """Build the ``InteractiveInput`` a tool-approval payload resumes with.
+
+        Mirrors ``AgentLifecycleHandler.on_tool_approval_result`` so the mailbox
+        fallback and the pub-sub event resume the interrupt identically (the
+        harness only accepts an ``InteractiveInput``). Returns ``None`` when the
+        payload carries no ``tool_call_id``.
+        """
