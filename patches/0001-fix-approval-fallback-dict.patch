+# coding: utf-8
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+"""Mailbox fallback for tool-approval results resumes with an InteractiveInput."""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from openjiuwen.agent_teams.agent.coordination.handlers.message import MessageHandler
+from openjiuwen.agent_teams.schema.team import TeamRole
+from openjiuwen.core.session import InteractiveInput
+
+
+def _handler(content: str):
+    msg = SimpleNamespace(message_id="m1", protocol="json", content=content, timestamp=1,
+                          from_member_name="leader-1", broadcast=False)
+    host = MagicMock()
+    host.has_pending_interrupt.return_value = True
+    host.resume_interrupt = AsyncMock()
+    host.deliver_input = AsyncMock()
+    mm = MagicMock()
+    mm.get_messages = AsyncMock(side_effect=[[msg], []])
+    mm.get_broadcast_messages = AsyncMock(return_value=[])
+    mm.mark_message_read = AsyncMock(return_value=True)
+    mm.mark_messages_read = AsyncMock(return_value=0)
+    infra = SimpleNamespace(message_manager=mm, team_backend=None)
+    blueprint = SimpleNamespace(member_name="dev-1", role=TeamRole.TEAMMATE)
+    return MessageHandler(host, blueprint, infra, MagicMock()), host, mm
+
+
+@pytest.mark.asyncio
+@pytest.mark.level0
+async def test_approval_message_resumes_with_interactive_input():
+    payload = json.dumps({"type": "tool_approval_result", "tool_call_id": "call-1",
+                          "approved": True, "feedback": "ok", "auto_confirm": True})
+    handler, host, mm = _handler(payload)
+
+    await handler._process_unread_messages("dev-1")
+
+    host.resume_interrupt.assert_awaited_once()
+    resume_input = host.resume_interrupt.await_args.args[0]
+    assert isinstance(resume_input, InteractiveInput)
+    assert resume_input.user_inputs["call-1"] == {"approved": True, "feedback": "ok", "auto_confirm": True}
+    mm.mark_message_read.assert_awaited_once_with("m1", "dev-1")
+    host.deliver_input.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.level0
+async def test_approval_message_stays_unread_when_resume_raises():
+    payload = json.dumps({"type": "tool_approval_result", "tool_call_id": "call-1", "approved": True})
+    handler, host, mm = _handler(payload)
+    host.resume_interrupt.side_effect = RuntimeError("boom")
+
+    with pytest.raises(RuntimeError):
+        await handler._process_unread_messages("dev-1")
+
+    mm.mark_message_read.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.level0
+async def test_approval_message_without_tool_call_id_is_consumed_not_resumed():
+    handler, host, mm = _handler(json.dumps({"type": "tool_approval_result", "approved": True}))
+
+    await handler._process_unread_messages("dev-1")
+
+    host.resume_interrupt.assert_not_awaited()
+    mm.mark_message_read.assert_awaited_once_with("m1", "dev-1")
