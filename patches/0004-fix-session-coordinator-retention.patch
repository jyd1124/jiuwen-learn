@@ -1032,6 +1049,31 @@ class RuntimeSessionCoordinator:
         if errors:
             raise errors[0]
 
+    def _retire_closed_session(self, record: _SessionRecord) -> None:
+        """Move a CLOSED record into bounded history and evict the oldest."""
+        self._closed_sessions.pop(record.session_id, None)
+        self._closed_sessions[record.session_id] = None
+        # Bounded scan: a record that still owns live executions (defensive;
+        # close_session only marks CLOSED once none are left) is skipped and
+        # retried on a later close instead of being dropped.
+        attempts = len(self._closed_sessions)
+        while len(self._closed_sessions) > self._closed_session_capacity and attempts > 0:
+            attempts -= 1
+            session_id, _ = self._closed_sessions.popitem(last=False)
+            current = self._sessions.get(session_id)
+            if current is None or current.state is not RuntimeSessionState.CLOSED:
+                continue
+            if self._registry.select(
+                session_id=session_id,
+                generation=current.generation,
+                active_only=True,
+            ):
+                self._closed_sessions[session_id] = None
+                continue
+            self._sessions.pop(session_id, None)
+            evicted = self._generations.pop(session_id, current.generation)
+            self._generation_floor = max(self._generation_floor, evicted)
+
     def _require_open_session(self, session_id: str) -> _SessionRecord:
         from jiuwenswarm.server.runtime.session.lifecycle import guard
         guard(session_id)
diff --git a/jiuwenswarm/tests/unit_tests/runtime/test_runtime_session_coordinator.py b/jiuwenswarm/tests/unit_tests/runtime/test_runtime_session_coordinator.py
index db07485..20b692b 100644
--- a/jiuwenswarm/tests/unit_tests/runtime/test_runtime_session_coordinator.py
+++ b/jiuwenswarm/tests/unit_tests/runtime/test_runtime_session_coordinator.py
@@ -1412,3 +1412,41 @@ async def test_quiesced_admission_rejects_every_new_team_input() -> None:
     with pytest.raises(RuntimeError, match="quiescing"):
         await admission.begin_session_message("session-a", "message-run")
     assert await admission.try_begin_heartbeat("session-a", "heartbeat-run") is False
+
+
+@pytest.mark.asyncio
+async def test_closed_sessions_are_bounded_and_generations_stay_monotonic() -> None:
+    coordinator = RuntimeSessionCoordinator(closed_session_capacity=2)
+    for index in range(5):
+        session_id = f"bounded-{index}"
+        await _register(coordinator, session_id)
+        assert await coordinator.run_unary(
+            session_id, "r", SessionWorkKind.CHAT_UNARY, lambda: asyncio.sleep(0, "ok")
+        ) == "ok"
+        assert not (await coordinator.close_session(session_id)).timed_out
+
+    # Only the most recently closed Sessions stay inspectable.
+    assert len(coordinator._sessions) == 2
+    assert len(coordinator._generations) == 2
+    assert coordinator.snapshot_session("bounded-0") is None
+    recent = coordinator.snapshot_session("bounded-4")
+    assert recent is not None and recent.state is RuntimeSessionState.CLOSED
+
+    # An evicted id never reuses an old generation, and a stale close is rejected.
+    reopened = await coordinator.register_session(
+        "bounded-0", "process", SessionPersistencePolicy.PERSISTENT
+    )
+    assert reopened.generation > 1
+    stale = await coordinator.close_session("bounded-0", generation=1)
+    assert stale.existed is False
+    current = coordinator.snapshot_session("bounded-0")
+    assert current is not None
+    assert current.generation == reopened.generation
+    assert current.state is RuntimeSessionState.READY
+
+    # Re-registering a still-retained closed id keeps per-id numbering.
+    again = await coordinator.register_session(
+        "bounded-4", "process", SessionPersistencePolicy.PERSISTENT
+    )
+    assert again.generation == recent.generation + 1
+    await coordinator.close()
