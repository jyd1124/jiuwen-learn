diff --git a/agent-core/tests/unit_tests/core/runner/callback/test_framework_serial_timeout.py b/agent-core/tests/unit_tests/core/runner/callback/test_framework_serial_timeout.py
new file mode 100644
index 0000000..78c3a24
--- /dev/null
+++ b/agent-core/tests/unit_tests/core/runner/callback/test_framework_serial_timeout.py
@@ -0,0 +1,59 @@
+# -*- coding: UTF-8 -*-
+# Copyright (c) Huawei Technologies Co., Ltd. 2026. All rights reserved.
+
+"""Serial trigger() honors the timeout a callback was registered with."""
+
+import asyncio
+import time
+
+import pytest
+
+
+@pytest.mark.asyncio
+async def test_serial_trigger_times_out_hung_callback_and_continues(framework):
+    ran = []
+
+    async def hung(*args, **kwargs):
+        await asyncio.sleep(1e6)
+
+    async def after(*args, **kwargs):
+        ran.append(True)
+        return "after"
+
+    await framework.register("evt", hung, priority=10, timeout=0.1)
+    await framework.register("evt", after, priority=0)
+
+    start = time.perf_counter()
+    results = await asyncio.wait_for(framework.trigger("evt"), timeout=5)
+
+    assert time.perf_counter() - start < 2
+    assert results == ["after"]
+    assert ran == [True]
+
+
+@pytest.mark.asyncio
+async def test_serial_trigger_fail_close_timeout_raises_and_stops_chain(framework):
+    ran = []
+
+    async def hung(*args, **kwargs):
+        await asyncio.sleep(1e6)
+
+    async def after(*args, **kwargs):
+        ran.append(True)
+
+    await framework.register("evt", hung, priority=10, timeout=0.1, fail_close=True)
+    await framework.register("evt", after, priority=0)
+
+    with pytest.raises(TimeoutError):
+        await asyncio.wait_for(framework.trigger("evt"), timeout=5)
+    assert ran == []
+
+
+@pytest.mark.asyncio
+async def test_serial_trigger_fast_callback_with_timeout_returns_result(framework):
+    async def fast(*args, **kwargs):
+        return 42
+
+    await framework.register("evt", fast, timeout=1.0)
+
+    assert await framework.trigger("evt") == [42]
